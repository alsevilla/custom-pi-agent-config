{
    "mcpServers":{
        "graphify": {
            "command": "~/AppData/Roaming/uv/tools/graphifyy/Scripts/python.exe",
            "args":[
                "-m",
                "graphify.serve",
                "--transport",
                "stdio",
                "--graph",
                "~/.graphify/global-graph.json"
            ]
        },
        "serena": {
        "command": "~/.local/bin/serena-agent.exe",
        "args": ["start-mcp-server", "--project-from-cwd"]
        }
    }
}
